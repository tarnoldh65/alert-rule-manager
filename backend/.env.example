# Copy to backend/.env for local (non-Docker) runs. In Docker, these are set
# via docker-compose.yml / the root .env instead.

ALERT_MANAGER_DATABASE_URL=postgresql://alertmanager:alertmanager@localhost:5432/alertmanager
ALERT_MANAGER_INGEST_HOST=0.0.0.0
ALERT_MANAGER_INGEST_PORT=7754
ALERT_MANAGER_API_HOST=0.0.0.0
ALERT_MANAGER_API_PORT=8000
